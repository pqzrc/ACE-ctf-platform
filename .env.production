# ============================================
# CTFd Configuration - ACE Production
# ============================================
# IMPORTANT: Remplacez les valeurs CHANGEME avant le déploiement

# === CTFd Core ===
SECRET_KEY=CHANGEME_CTFD_SECRET_KEY_64_CHARS
MYSQL_ROOT_PASSWORD=CHANGEME_MYSQL_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGEME_MYSQL_CTFD_PASSWORD

# === Integration with Registration Site (REQUIRED) ===
# URL de l'API du site d'inscription Next.js/Express
REGISTRATION_SITE_URL=http://ace-website-backend-1:5000/api

# Identifiants admin pour se connecter à l'API
REGISTRATION_SITE_ADMIN_EMAIL=admin@vizyondijital.fr
REGISTRATION_SITE_ADMIN_PASSWORD=CHANGEME_SAME_AS_WEBSITE_ADMIN_PASSWORD

# === SSO Configuration ===
# DOIT être IDENTIQUE au JWT_SECRET du site d'inscription
JWT_SECRET=CHANGEME_GENERATE_STRONG_SECRET_64_CHARS
CTFD_PUBLIC_URL=https://ctfd.vizyondijital.fr

# URL du site d'inscription frontend (pour les redirections depuis CTFd)
FRONTEND_URL=https://ace.vizyondijital.fr

# === Webhook Configuration ===
# DOIT être IDENTIQUE au WEBHOOK_SECRET du site d'inscription
WEBHOOK_SECRET=CHANGEME_WEBHOOK_SECRET_SHARED_WITH_WEBSITE

# === Mail Configuration (Optional) ===
# Note: Le site d'inscription gère déjà les emails
# Ces paramètres sont optionnels pour CTFd
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGEME_your-email@gmail.com
MAIL_PASSWORD=CHANGEME_your-app-password
MAILFROM_ADDR=noreply@vizyondijital.fr

# === CTFd Admin (Initial Setup) ===
# Utilisé uniquement pour la première installation
CTFD_ADMIN_USER=admin
CTFD_ADMIN_EMAIL=admin@vizyondijital.fr
CTFD_ADMIN_PASSWORD=CHANGEME_CTFD_ADMIN_PASSWORD

# === For Scripts ===
# URL de CTFd pour les scripts d'import
CTFD_URL=https://ctfd.vizyondijital.fr

# Token API CTFd (obtenu depuis Settings > Access Tokens après installation)
CTFD_TOKEN=

# ============================================
# Comment générer des secrets sécurisés :
# ============================================
# SECRET_KEY / JWT_SECRET (64 caractères) :
#   openssl rand -hex 32
#
# MYSQL_PASSWORD (32 caractères) :
#   openssl rand -base64 24
#
# WEBHOOK_SECRET (32 caractères) :
#   openssl rand -hex 16
#
# IMPORTANT: JWT_SECRET et WEBHOOK_SECRET doivent être
# identiques dans .env.website.production et .env.ctfd.production
#
