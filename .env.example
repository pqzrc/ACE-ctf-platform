# ============================================
# CTFd Configuration - Environment
# ============================================
#
# IMPORTANT: Sur le VPS, faites:
#   cp .env.example .env
#   nano .env
#   # Remplacez tous les CHANGEME par vos vraies valeurs
#
# CRITIQUES: Ces valeurs DOIVENT être identiques à ACE-Website:
#   - JWT_SECRET
#   - WEBHOOK_SECRET
#   - REGISTRATION_SITE_ADMIN_PASSWORD
#
# ============================================

# CTFd Core
SECRET_KEY=CHANGEME_VERY_LONG_RANDOM_SECRET_KEY
MYSQL_ROOT_PASSWORD=CHANGEME_MYSQL_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGEME_MYSQL_CTFD_PASSWORD

# Integration with Registration Site
# Utiliser le nom du service Docker
REGISTRATION_SITE_URL=http://backend:5000/api
REGISTRATION_SITE_ADMIN_EMAIL=admin@ace-escapegame.com
REGISTRATION_SITE_ADMIN_PASSWORD=CHANGEME_SAME_AS_WEBSITE_ADMIN

# SSO Configuration
# IMPORTANT: IDENTIQUE à ACE-Website!
JWT_SECRET=CHANGEME_SAME_JWT_SECRET_AS_WEBSITE
CTFD_PUBLIC_URL=https://ctfd.vizyondijital.fr
FRONTEND_URL=https://ace.vizyondijital.fr

# Webhook Configuration
# IMPORTANT: IDENTIQUE à ACE-Website!
WEBHOOK_SECRET=CHANGEME_SAME_WEBHOOK_SECRET_AS_WEBSITE

# Mail Configuration (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAILFROM_ADDR=noreply@ace-escapegame.com

# Event Configuration
EVENT_START_TIME=2025-02-01T09:00:00Z
EVENT_END_TIME=2025-02-01T17:00:00Z

# CTFd Configuration
CTF_NAME=ACE Escape Game 2025
CTF_DESCRIPTION=Plateforme CTF pour ACE Escape Game Cybersécurité

# CTFd Admin (Initial Setup)
CTFD_ADMIN_USER=admin
CTFD_ADMIN_EMAIL=admin@ace-escapegame.com
CTFD_ADMIN_PASSWORD=CHANGEME_CTFD_ADMIN_PASSWORD

# For Scripts
CTFD_URL=https://ctfd.vizyondijital.fr
CTFD_TOKEN=
