# ============================================
# CTFd Configuration - Environment Template
# ============================================
#
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env.local (for local dev)
# 2. Fill in ALL values marked with CHANGEME
# 3. For production, use secure secrets management
#
# ============================================

# === CTFd Core ===
# Generate: openssl rand -hex 32
SECRET_KEY=CHANGEME_VERY_LONG_RANDOM_SECRET_KEY
# Generate: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=CHANGEME_MYSQL_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGEME_MYSQL_PASSWORD

# === Integration with Registration Site ===
REGISTRATION_SITE_URL=http://backend:5000/api
REGISTRATION_SITE_ADMIN_EMAIL=admin@yourdomain.com
# Must match ACE-Website ADMIN_PASSWORD
REGISTRATION_SITE_ADMIN_PASSWORD=CHANGEME_ADMIN_PASSWORD

# === SSO Configuration ===
# IMPORTANT: Must be IDENTICAL to ACE-Website JWT_SECRET!
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGEME_JWT_SECRET_MIN_32_CHARS
# Local: http://localhost:8000 | Prod: https://ctfd.yourdomain.com
CTFD_PUBLIC_URL=http://localhost:8000
# Local: http://localhost:3000 | Prod: https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# === Webhook Configuration ===
# IMPORTANT: Must be IDENTICAL to ACE-Website WEBHOOK_SECRET!
# Generate: openssl rand -hex 16
WEBHOOK_SECRET=CHANGEME_WEBHOOK_SECRET

# === Mail Configuration ===
# For local dev, use MailHog (localhost:1025)
# For production, configure your SMTP server
MAIL_SERVER=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAILFROM_ADDR=noreply@yourdomain.com

# === Event Configuration ===
EVENT_START_TIME=2025-12-11T09:00:00Z
EVENT_END_TIME=2025-12-11T18:00:00Z

# === CTFd Configuration ===
CTF_NAME=ACE Escape Game 2025
CTF_DESCRIPTION=Plateforme CTF pour ACE Escape Game Cybersecurite

# === CTFd Admin (Initial Setup) ===
CTFD_ADMIN_USER=admin
CTFD_ADMIN_EMAIL=admin@yourdomain.com
# Generate: openssl rand -base64 24
CTFD_ADMIN_PASSWORD=CHANGEME_CTFD_ADMIN_PASSWORD

# === For Scripts ===
CTFD_URL=http://localhost:8000
# Get from CTFd Admin Panel > Settings > Access Tokens
CTFD_TOKEN=CHANGEME_CTFD_API_TOKEN
