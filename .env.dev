# CTFd Configuration - DEV LOCAL

# === CTFd Core ===
SECRET_KEY=dev_ctfd_secret_key_changez_moi
MYSQL_ROOT_PASSWORD=dev_mysql_root_pass
MYSQL_PASSWORD=dev_ctfd_password

# === Integration with Registration Site ===
# Utiliser le nom du service Docker backend
REGISTRATION_SITE_URL=http://backend:5000/api
REGISTRATION_SITE_ADMIN_EMAIL=admin@ace.local
REGISTRATION_SITE_ADMIN_PASSWORD=Admin123!

# === Development Settings ===
NODE_ENV=development

# === Event Configuration ===
# 11 décembre 2025 à 18h30 EST (23h30 UTC) jusqu'à 23h00 EST (04h00 UTC le 12)
EVENT_START_TIME=2025-12-11T23:30:00Z
EVENT_END_TIME=2025-12-12T04:00:00Z

# === SSO Configuration ===
JWT_SECRET=dev_jwt_secret_changez_moi
CTFD_PUBLIC_URL=http://localhost:8000
# Utiliser le nom du service Docker frontend
FRONTEND_URL=http://frontend:3000

# === Webhook Configuration ===
WEBHOOK_SECRET=dev_webhook_secret_shared

# === Mail Configuration ===
MAIL_SERVER=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAILFROM_ADDR=noreply@ace.local

# === CTFd Configuration ===
CTF_NAME=ACE Escape Game 2025 - DEV
CTF_DESCRIPTION=Plateforme CTF - Développement

# === CTFd Admin ===
CTFD_ADMIN_USER=admin
CTFD_ADMIN_EMAIL=admin@ace.local
CTFD_ADMIN_PASSWORD=Admin123!
